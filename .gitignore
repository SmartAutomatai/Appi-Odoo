# Entorno Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Los .env por rama llevan credenciales; el script que los cambia, no.
entornos/*.env
!entornos/cambiar.ps1
!entornos/README.md

# Base de datos de control local (SQLite)
*.db
control.db

# Artefactos de test
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# IDEs
.vscode/
.idea/
*.swp

# Distribucion
dist/
build/
*.egg-info/

# Clon git separado (repositorio distinto, no forma parte de este proyecto)
API-Odoo Helpdesk Sestia/
API-Odoo-Helpdesk-Sestia/

# Documentos personales ajenos al proyecto
resume/

# Documentos de trabajo (informes, actas de reunion): son del usuario, no del repo.
*.docx
*.xlsx
!docs/**/*.xlsx

# Informes locales (auditorias, notas): se quedan en la maquina, no en el repo.
# Una auditoria describe donde estaban los huecos: util para el equipo,
# innecesario de publicar.
*.local.md

# Trabajo ajeno a este repo que vive en la misma carpeta (contratos Solidity,
# material de auditoria). No se borra, solo se oculta para que "git status"
# vuelva a ser legible y no acabe commiteado por error.
/token/
/DeFiHackLabs/
/Standard-Gold-Coin-main/
/Standard-Gold-Coin-main*.zip
/.gitmodules
